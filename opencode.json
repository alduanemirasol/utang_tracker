{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "plan",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "instructions": [
    "AGENTS.md",
    ".opencode/WORKFLOWS.md"
  ],
  "agent": {
    "build": {
      "color": "#5c9cf5"
    },
    "plan": {
      "color": "#f5a742"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".dart_tool/**",
      ".idea/**",
      ".gradle/**",
      ".kotlin/**",
      "*.iml",
      ".flutter-plugins-dependencies",
      "android/key.properties",
      "android/local.properties",
      "android/app/utang-tracker-release.jks"
    ]
  },
  "permission": {
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "bash": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "task": "allow",
    "list": "allow",
    "lsp": "allow"
  }
}