{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": true,
  "formatter": true,
  "instructions": ["AGENTS.md", ".opencode/rules/*.md"],
  "watcher": {
    "ignore": [
      ".git/**",
      ".dart_tool/**",
      ".idea/**",
      ".gradle/**",
      ".kotlin/**",
      "*.iml",
      ".flutter-plugins-dependencies",
      "android/key.properties",
      "android/local.properties",
      "android/app/utang-tracker-release.jks"
    ]
  },
  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "edit": "ask",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "bash": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "task": "allow",
    "list": "allow",
    "lsp": "allow"
  }
}
